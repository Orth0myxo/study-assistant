# Copy to .env.local (gitignored) and restart Expo with `npx expo start -c`.
#
# Expo SDK 57 replaces the global fetch with expo/fetch, which rejects React
# Native multipart file parts ({ uri, name, type }) with
# "Unsupported FormDataPart implementation". Keeping React Native's fetch makes
# PDF/DOCX uploads work in both Expo Go and development builds.
EXPO_PUBLIC_USE_RN_FETCH=true

# Optional: point a standalone build at a deployed backend and (if the server
# sets APP_ACCESS_TOKEN) send the matching shared secret. For EAS builds set
# these in eas.json / EAS environment variables instead of committing them.
# EXPO_PUBLIC_API_URL=https://your-service.onrender.com
# EXPO_PUBLIC_API_TOKEN=
