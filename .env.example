# AI Study Assistant — environment example
# Copy to .env and fill in real values. NEVER commit .env.
# The mobile app must not contain any of these secrets.

# --- Gemini AI provider (server-side only) ---
# Google Gemini Developer API key. Secret. Server-side only. Never expose to mobile.
GEMINI_API_KEY=
# Model identifier. Default is a current stable free-tier model.
# Verify against https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_MODEL=gemini-3.8-flash
# Gemini Developer API base URL (v1beta generateContent).
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Per-request timeout in seconds.
GEMINI_REQUEST_TIMEOUT_S=60
# Maximum output tokens per summary request.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Retries for retryable provider errors (429 / 5xx / network).
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_S=1.0
# Maximum characters sent to the AI per request (documents are chunked to fit).
MAX_SUMMARY_CHUNK_CHARS=12000

# --- Upload / processing limits ---
MAX_UPLOAD_MB=25
# How long uploaded documents and study results are retained on the server
# (minutes). Default is 7 days. Completed results stay readable/exportable for
# this window even after the source document is deleted.
RETENTION_MINUTES=10080
JOB_TIMEOUT_S=300
RATE_LIMIT_PER_MINUTE=30
# Jobs with <= this many sections run synchronously and return results inline.
# Larger jobs return a job_id for status polling.
SYNC_PROCESSING_MAX_SECTIONS=20

# --- Document extraction ---
# Directory for stored uploaded files (deleted on expiry/DELETE).
TEMP_DIR=.tmp/uploads
# SQLite database file for document metadata and study-job results.
# Keep it inside the git-ignored .tmp/ directory; it holds user content metadata.
DATABASE_PATH=.tmp/study.db
# Minimum non-whitespace characters for a PDF page to count as readable text.
# 15 excludes page numbers, short headers ("Lecture 3", 8) and short
# watermarks ("Confidential", 12) while admitting a short content line.
# Pages below the threshold are omitted from sections and reported in warnings.
MIN_PDF_CHARS_PER_PAGE=15
# Reject DOCX files whose uncompressed contents exceed this size (ZIP-bomb
# guard). Normal lecture notes are far below this limit.
MAX_DOCX_UNCOMPRESSED_MB=100
# How often the background task sweeps expired temporary files (seconds).
CLEANUP_INTERVAL_S=60

# --- OCR (scanned PDF pages and embedded DOCX images) ---
# Tesseract CLI executable. Use `tesseract` when it is on PATH, or an absolute
# Windows path such as C:\Program Files\Tesseract-OCR\tesseract.exe.
OCR_TESSERACT_PATH=tesseract
# Maximum OCR operations per document (PDF pages or DOCX images).
# Set to 0 to disable OCR.
OCR_PAGE_LIMIT=30
# PDF page render resolution. Higher values improve small text but use more memory.
OCR_DPI=200
# Per-page/image Tesseract timeout in seconds.
OCR_TIMEOUT_S=30
# Tesseract language data, for example eng or eng+deu.
OCR_LANGUAGE=eng

# --- Backend ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for CORS in dev (emulator/localhost)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
LOG_LEVEL=info
# Optional shared-secret gate for temporary public hosting. When set, every
# request except /health requires the "X-App-Token" header or a "?token=" query
# parameter. Leave unset for local development.
APP_ACCESS_TOKEN=
