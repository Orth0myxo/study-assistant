# AI Study Assistant — environment example
# Copy to .env and fill in real values. NEVER commit .env.
# The mobile app must not contain any of these secrets.

# --- Gemini AI provider (server-side only) ---
# Google Gemini Developer API key. Secret. Server-side only. Never expose to mobile.
GEMINI_API_KEY=
# Model identifier. Default is a current stable free-tier model.
# Verify against https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_MODEL=gemini-3.8-flash
# Gemini Developer API base URL (v1beta generateContent).
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Per-request timeout in seconds.
GEMINI_REQUEST_TIMEOUT_S=60
# Maximum output tokens per summary request.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Retries for retryable provider errors (429 / 5xx / network).
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_S=1.0

# --- Agent provider (OpenAI-compatible) ---
# For Groq: AGENT_API_KEY is the Groq key, AGENT_MODEL=qwen/qwen3.8-27b, and
# AGENT_BASE_URL=https://api.groq.com/openai/v1. The model must support
# OpenAI-style tool/function calling. Groq/Gemini stay on summaries and commands.
AGENT_API_KEY=
AGENT_MODEL=
AGENT_BASE_URL=
# Request body controls for reasoning models. `low` or `none` keeps thinking
# tokens from consuming the output-per-minute allowance. Set blank to omit.
AGENT_REASONING_EFFORT=low
# Required on every agent call; keep below the provider's output-token/minute cap.
# Final-answer calls use this cap; calls where tools are offered use the next one.
AGENT_MAX_OUTPUT_TOKENS=500
AGENT_TOOL_MAX_OUTPUT_TOKENS=800
# Optional process-wide guard against Groq's output-token/minute limit, per backend
# worker. Leave blank to disable. Used with response usage before the next model call.
AGENT_OUTPUT_TOKENS_PER_MINUTE=1000

# Optional study-agent API. Off unless explicitly enabled by the owner.
AGENT_ENABLED=false
# Agent-only provider order. Add agent,groq or agent,gemini only if you want
# fallback to the summary providers; fallbacks consume their quota too.
AGENT_PROVIDER_ORDER=agent
# Per-request safety limits for the agent loop.
AGENT_MAX_MODEL_CALLS=4
# Summary chunks use their own model-call budget, separate from the agent loop.
AGENT_SUMMARY_MODEL_CALLS=8
# Skip another detailed-summary part when less request time than this remains.
AGENT_SUMMARY_PART_MIN_SECONDS=5
AGENT_MAX_TOOL_CALLS=6
AGENT_TOKEN_BUDGET=7000
AGENT_REQUEST_TIMEOUT_S=45
# Wait out one provider 429 when the honest wait fits this many seconds; 0 disables it.
AGENT_RATE_LIMIT_WAIT_S=20
AGENT_TOOL_RESULT_CHARS=4000
# Recent chat turns sent back for follow-ups, bounded by a token budget.
AGENT_MEMORY_TURNS=2
AGENT_MEMORY_TOKENS=300
# How long a paused page-read approval can be resumed (seconds).
AGENT_PENDING_TTL_S=120
# Source sampling and page-range bounds for agent summaries and page reads.
AGENT_DOCUMENT_SAMPLE_CHARS=24000
AGENT_MAX_PAGE_RANGE=50

# --- Groq AI provider (server-side only) ---
# Provider order for summary requests. Providers without keys are skipped.
AI_PROVIDER_ORDER=groq,gemini
# Summaries default to Gemini first, then Groq. Commands still use Groq.
SUMMARY_PROVIDER_ORDER=gemini,groq
GROQ_API_KEY=
# Groq model ID verified in current docs; supports tool use and JSON mode.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_COMMAND_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT_S=60
GROQ_MAX_OUTPUT_TOKENS=2048
# Maximum characters sent to AI per chunk (approximately 500-800 words).
MAX_SUMMARY_CHUNK_CHARS=4000
# At or below this size, summaries_only makes one summary call and skips parts.
SUMMARY_SINGLE_CALL_CHARS=40000
# Hard word caps applied after the model answers (0 disables). Prompts ask for less.
SUMMARY_MAX_WORDS=150
OVERVIEW_MAX_WORDS=100
BEYOND_MAX_WORDS=100
# Whole-material summary jobs: pacing and rate-limit patience (seconds).
SUMMARY_UNIT_DELAY_S=1.5
SUMMARY_RATE_LIMIT_RETRIES=2
SUMMARY_RATE_LIMIT_WAIT_CAP_S=45
SUMMARY_RATE_LIMIT_DEFAULT_WAIT_S=20
SUMMARY_WAIT_BUDGET_S=150

# --- Upload / processing limits ---
MAX_UPLOAD_MB=25
# Reject PDFs above this page count before OCR or parsing work starts.
MAX_PAGES=50
# Reject DOCX files above this word count before image OCR work starts.
MAX_DOCX_WORDS=30000
# Return from upload immediately and process pages in a background thread.
# Set false only for debugging; clients then receive a fully parsed document.
BACKGROUND_INGEST=true
# Process-local background ingest workers.
INGEST_WORKERS=2
# How long uploaded documents and study results are retained on the server
# (minutes). Default is 7 days. Completed results stay readable/exportable for
# this window even after the source document is deleted.
RETENTION_MINUTES=10080
JOB_TIMEOUT_S=300
RATE_LIMIT_PER_MINUTE=30
# Jobs with <= this many sections run synchronously and return results inline.
# Larger jobs return a job_id for status polling.
SYNC_PROCESSING_MAX_SECTIONS=20

# --- Document extraction ---
# Directory for stored uploaded files (deleted on expiry/DELETE).
TEMP_DIR=.tmp/uploads
# SQLite database file for document metadata and study-job results.
# Keep it inside the git-ignored .tmp/ directory; it holds user content metadata.
DATABASE_PATH=.tmp/study.db
# Minimum non-whitespace characters for a PDF page to count as readable text.
# 15 excludes page numbers, short headers ("Lecture 3", 8) and short
# watermarks ("Confidential", 12) while admitting a short content line.
# Pages below the threshold are omitted from sections and reported in warnings.
MIN_PDF_CHARS_PER_PAGE=15
# Reject DOCX files whose uncompressed contents exceed this size (ZIP-bomb
# guard). Normal lecture notes are far below this limit.
MAX_DOCX_UNCOMPRESSED_MB=100
# How often the background task sweeps expired temporary files (seconds).
CLEANUP_INTERVAL_S=60

# --- OCR (scanned PDF pages and embedded DOCX images) ---
# Tesseract CLI executable. Use `tesseract` when it is on PATH, or an absolute
# Windows path such as C:\Program Files\Tesseract-OCR\tesseract.exe.
OCR_TESSERACT_PATH=tesseract
# Maximum OCR operations per document (PDF pages or DOCX images).
# Set to 0 to disable OCR.
OCR_PAGE_LIMIT=30
# PDF page render resolution. Higher values improve small text but use more memory.
OCR_DPI=200
# Per-page/image Tesseract timeout in seconds.
OCR_TIMEOUT_S=30
# Tesseract language data, for example eng or eng+deu.
OCR_LANGUAGE=eng

# --- Topic sources (note images + editable OCR transcripts) ---
# Bounds are per topic source; combined bytes still use MAX_UPLOAD_MB.
TOPIC_MAX_IMAGES=10
TOPIC_MAX_IMAGE_MB=10
TOPIC_MAX_IMAGE_PIXELS=40000000
TOPIC_MAX_TOPICS=20
TOPIC_MAX_TOPIC_CHARS=200
TOPIC_MAX_TRANSCRIPT_CHARS=50000
# Active sources per user. Deleting a source frees a slot.
TOPIC_MAX_SOURCES_PER_USER=20
# Process-local cap on concurrent topic-image OCR calls.
TOPIC_OCR_MAX_CONCURRENCY=4

# Image reading across study chat, outline images, and the converter. Local
# Tesseract remains the default where available; explicit AI reads use this
# provider. Set IMAGE_READING_PROVIDER=gemini to opt back into Gemini.
IMAGE_READING_PROVIDER=groq
TABLE_VISION_MAX_OUTPUT_TOKENS=4096
TABLE_MAX_ROWS=200
TABLE_MAX_COLUMNS=30
TABLE_MAX_CELL_CHARS=500
# Deterministic topic matching controls. Weak matches remain unmatched.
MIN_MATCH_SCORE=0.62
MAX_MATCHES_PER_TOPIC=10

# --- Backend ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for CORS in dev (emulator/localhost)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
LOG_LEVEL=info
# Optional shared-secret gate for temporary public hosting. When set, requests
# that do not carry a valid per-user bearer token must include the "X-App-Token"
# header or a "?token=" query parameter. Registration and /health are exempt,
# and a valid per-user token is sufficient for API data requests. If a client
# sends "X-App-Token", it must match. Leave unset for local development.
APP_ACCESS_TOKEN=

# Chat command step: give up on Groq after this many seconds and use the local
# parser (the app itself waits 15s). Requests slower than SLOW_REQUEST_LOG_MS are
# logged; every response carries a Server-Timing header.
GROQ_COMMAND_TIMEOUT_S=8
SLOW_REQUEST_LOG_MS=2000
