# AI Study Assistant — environment example
# Copy to .env and fill in real values. NEVER commit .env.
# The mobile app must not contain any of these secrets.

# --- AI provider (server-side only) ---
# OpenAI-compatible chat API base URL, e.g. https://api.openai.com/v1
AI_PROVIDER_BASE_URL=
# Provider API key. Secret. Server-side only.
AI_PROVIDER_API_KEY=
# Model identifier, e.g. gpt-4o-mini or a self-hosted model name
AI_MODEL=
# Optional: provider label shown in /health (free-form)
AI_PROVIDER_NAME=

# --- AI limits ---
AI_REQUEST_TIMEOUT_S=60
MAX_AI_TOKENS_PER_REQUEST=2048
MAX_SECTION_CHARS=6000

# --- Upload / processing limits ---
MAX_UPLOAD_MB=25
FILE_TTL_MINUTES=60
JOB_TIMEOUT_S=300
RATE_LIMIT_PER_MINUTE=30

# --- Backend ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for CORS in dev (emulator/localhost)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
LOG_LEVEL=info
